# ============================================
# ATE Digital Arena — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ate_digital_arena?schema=public"

# ============================================
# REDIS (optional for dev, required for prod)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# AUTH
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-change-in-production"
# Session duration in days
SESSION_DURATION_DAYS=7
# Optional: password used when running database seed (change in production)
SEED_DEFAULT_PASSWORD="ChangeMeInProduction123!"

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ATE Digital Arena"
NODE_ENV="development"

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="your-resend-api-key"
SMTP_FROM="ATE Digital Arena <noreply@ate.gg>"

# ============================================
# SMS (Adapter - mock in development)
# ============================================
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER="ATE"

# ============================================
# FILE STORAGE (S3 compatible)
# ============================================
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# ============================================
# CAPTCHA (Cloudflare Turnstile)
# ============================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ============================================
# EXTERNAL SERVICES
# ============================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=""
